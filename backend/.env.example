# Copy this file to ".env" and fill in real values before running the server.

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/company_portal_db
# Or MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/company_portal_db

# Secret used to sign JSON Web Tokens. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on.
PORT=5000
